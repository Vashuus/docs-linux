{
  "id": "crunch",
  "title": "crunch — Generador de diccionarios",
  "description": "Crea listas de palabras personalizadas según longitud y juego de caracteres.",
  "syntax": "crunch min max [conjunto] -o salida",
  "examples": [
    {
      "cmd": "crunch 4 6 0123456789 -o pins.txt",
      "desc": "Genera PINs de 4 a 6 dígitos."
    },
    {
      "cmd": "crunch 8 8 abc123 -o lista.txt",
      "desc": "Longitud fija con charset."
    }
  ],
  "options": [
    {
      "flag": "min max",
      "desc": "Longitud mínima y máxima."
    },
    {
      "flag": "(charset)",
      "desc": "Caracteres a usar."
    },
    {
      "flag": "-o",
      "desc": "Archivo de salida."
    },
    {
      "flag": "-t",
      "desc": "Patrón."
    }
  ]
}
