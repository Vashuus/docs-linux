{
  "id": "gau",
  "title": "gau — Obtener URLs de fuentes",
  "description": "Recupera URLs conocidas de un dominio desde Wayback, Common Crawl y más.",
  "syntax": "gau [opciones] dominio",
  "examples": [
    {
      "cmd": "gau ejemplo.com",
      "desc": "Obtiene URLs históricas."
    },
    {
      "cmd": "gau --subs ejemplo.com",
      "desc": "Incluye subdominios."
    }
  ],
  "options": [
    {
      "flag": "--subs",
      "desc": "Incluye subdominios."
    },
    {
      "flag": "--threads",
      "desc": "Número de hilos."
    },
    {
      "flag": "--from",
      "desc": "Fecha inicial."
    },
    {
      "flag": "-o",
      "desc": "Salida."
    }
  ]
}
