{
  "id": "arpspoof",
  "title": "arpspoof — Envenenamiento ARP",
  "description": "Redirige el tráfico de una víctima envenenando la caché ARP.",
  "syntax": "sudo arpspoof [opciones] -i interfaz -t victima gateway",
  "examples": [
    {
      "cmd": "sudo arpspoof -i eth0 -t 192.168.1.10 192.168.1.1",
      "desc": "Envenena la víctima apuntando al gateway."
    },
    {
      "cmd": "sudo arpspoof -i eth0 192.168.1.1",
      "desc": "Envenena toda la subred."
    }
  ],
  "options": [
    {
      "flag": "-i",
      "desc": "Interfaz."
    },
    {
      "flag": "-t",
      "desc": "Objetivo."
    },
    {
      "flag": "-r",
      "desc": "Envenenamiento bidireccional."
    },
    {
      "flag": "-c",
      "desc": "Propio MAC."
    }
  ]
}
