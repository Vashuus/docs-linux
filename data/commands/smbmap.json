{
  "id": "smbmap",
  "title": "smbmap — Mapear recursos SMB",
  "description": "Enumera permisos y recursos compartidos SMB de un host.",
  "syntax": "smbmap -H host",
  "examples": [
    {
      "cmd": "smbmap -H 192.168.1.10",
      "desc": "Lista recursos y permisos."
    },
    {
      "cmd": "smbmap -H 192.168.1.10 -R",
      "desc": "Recursivo."
    }
  ],
  "options": [
    {
      "flag": "-H",
      "desc": "Host o IP."
    },
    {
      "flag": "-u",
      "desc": "Usuario."
    },
    {
      "flag": "-p",
      "desc": "Contraseña."
    },
    {
      "flag": "-R",
      "desc": "Listado recursivo."
    }
  ]
}
