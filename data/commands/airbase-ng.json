{
  "id": "airbase-ng",
  "title": "airbase-ng — Punto de acceso falso",
  "description": "Crea puntos de acceso falsos (rogue AP) para capturar tráfico.",
  "syntax": "sudo airbase-ng [opciones] interfaz",
  "examples": [
    {
      "cmd": "sudo airbase-ng -e 'WiFi Gratis' -c 6 wlan0mon",
      "desc": "Crea un AP falso."
    },
    {
      "cmd": "sudo airbase-ng -P wlan0mon",
      "desc": "Modo responder."
    }
  ],
  "options": [
    {
      "flag": "-e",
      "desc": "ESSID del AP."
    },
    {
      "flag": "-c",
      "desc": "Canal."
    },
    {
      "flag": "-P",
      "desc": "Modo responder."
    },
    {
      "flag": "-a",
      "desc": "BSSID."
    }
  ]
}
