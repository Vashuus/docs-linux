{
  "id": "wfuzz",
  "title": "wfuzz — Fuzzing web",
  "description": "Fuzzer flexible para descubrir recursos, inyección y fuerza bruta en aplicaciones web.",
  "syntax": "wfuzz [opciones] URL/FUZZ",
  "examples": [
    {
      "cmd": "wfuzz -w lista.txt https://ejemplo.com/FUZZ",
      "desc": "Fuzzing de rutas."
    },
    {
      "cmd": "wfuzz -w users.txt -w pass.txt https://ejemplo.com/login",
      "desc": "Fuerza bruta de login."
    }
  ],
  "options": [
    {
      "flag": "-w",
      "desc": "Diccionario."
    },
    {
      "flag": "--hc",
      "desc": "Oculta códigos."
    },
    {
      "flag": "-z",
      "desc": "Iterador de payload."
    },
    {
      "flag": "-b",
      "desc": "Cookie."
    }
  ]
}
