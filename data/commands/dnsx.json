{
  "id": "dnsx",
  "title": "dnsx — Toolkit DNS",
  "description": "Resuelve, filtra y valida registros DNS de forma masiva.",
  "syntax": "dnsx [opciones]",
  "examples": [
    {
      "cmd": "cat subs.txt | dnsx -a -resp",
      "desc": "Resuelve registros A."
    },
    {
      "cmd": "cat subs.txt | dnsx -cname -resp-only",
      "desc": "Extrae CNAMEs."
    }
  ],
  "options": [
    {
      "flag": "-a",
      "desc": "Registros A."
    },
    {
      "flag": "-cname",
      "desc": "Registros CNAME."
    },
    {
      "flag": "-resp",
      "desc": "Muestra la respuesta."
    },
    {
      "flag": "-silent",
      "desc": "Salida limpia."
    }
  ]
}
