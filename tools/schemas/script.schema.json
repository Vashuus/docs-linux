{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Script",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "icon", "lang", "script"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "icon": { "type": "string", "pattern": "^svg/[a-z0-9-]+\\.svg$" },
    "lang": { "type": "string", "enum": ["bash", "sh", "zsh", "python"] },
    "type": { "type": "string" },
    "version": { "type": "string" },
    "reliability": { "type": "integer", "minimum": 0, "maximum": 100 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "requires": { "type": "array", "items": { "type": "string" } },
    "usage": { "type": "array", "items": { "type": "string" } },
    "script": { "type": "string", "pattern": "^scripts/[a-z0-9-]+\\.(sh|py)$" }
  }
}
